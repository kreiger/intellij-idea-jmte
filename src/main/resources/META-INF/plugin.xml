<idea-plugin>
    <id>com.linuxgods.kreiger.idea.jmte</id>
    <idea-version since-build="233"/>

    <name>JMTE: Java Minimal Template Language</name>
    
    <vendor email="christoffer.hammarstrom@gmail.com">Christoffer Hammarström</vendor>

    <description><![CDATA[
        <blockquote>
        <a href="https://github.com/DJCordhose/jmte">The Java project Minimal Template Engine</a> is meant to fill the gap
        between simple string formatting with basic Java classes like String.format
        and complex template solutions like Velocity or StringTemplate.
        </blockquote>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="JMTE" implementationClass="com.linuxgods.kreiger.idea.jmte.JmteFileType"
                  fieldName="INSTANCE" extensions="mte" language="JMTE"/>

        <lang.parserDefinition language="JMTE"
                               implementationClass="com.linuxgods.kreiger.idea.jmte.JmteParserDefinition"/>
        <lang.fileViewProviderFactory language="JMTE"
                                      implementationClass="com.linuxgods.kreiger.idea.jmte.JmteFileViewProviderFactory"/>
        <lang.formatter language="JMTE"
                        implementationClass="com.linuxgods.kreiger.idea.jmte.JmteFormattingModelBuilder"/>

        <fileEditorProvider implementation="com.linuxgods.kreiger.idea.jmte.JmteFileEditorProvider"/>
        <daemon.highlightInfoFilter implementation="com.linuxgods.kreiger.idea.jmte.JmteErrorFilter"/>
        <highlightErrorFilter implementation="com.linuxgods.kreiger.idea.jmte.JmteErrorFilter" />
        <editorNotificationProvider implementation="com.linuxgods.kreiger.idea.jmte.JmteEditorNotificationProvider"/>

        <lang.syntaxHighlighter language="JMTE" implementationClass="com.linuxgods.kreiger.idea.jmte.JmteSyntaxHighlighter"/>
        <syntaxHighlighter key="JMTE" implementationClass="com.linuxgods.kreiger.idea.jmte.JmteSyntaxHighlighter"/>
        <editorHighlighterProvider filetype="JMTE" implementationClass="com.linuxgods.kreiger.idea.jmte.JmteEditorHighlighterProvider" />
        <completion.contributor language="JMTE" implementationClass="com.linuxgods.kreiger.idea.jmte.JmteCompletionContributor"/>
    </extensions>
</idea-plugin>